<h1><%= @message %></h1>

<div id="map"></div>

<script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['PLACES_API_KEY'] %>&callback=initMap"></script>

<script>
  function initMap() {
    const MyLatLng = new google.maps.LatLng(35.681236, 139.767125);
    const Options = {
      zoom: 15,
      center: MyLatLng,
      mapTypeId: 'roadmap'
    };
    const map = new google.maps.Map(document.getElementById('map'), Options);
    console.log(map)

    const marker = new google.maps.Marker({
      position: MyLatLng,
      map: map,
    });
  }
</script>

<style>
#map {
  width: 1000px;
  height: 600px;
}
</style>
